        <mxCell id="s_title" value="Sequence diagram – student books a slot (with &amp;quot;slot full&amp;quot; path)" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="s_student" value=":Student (Postman)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="160" height="1080" as="geometry" /></mxCell>
