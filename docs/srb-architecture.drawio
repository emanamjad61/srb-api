        <mxCell id="s_service" value=":BookingService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="460" y="80" width="160" height="1080" as="geometry" /></mxCell>
        <mxCell id="s_db" value=":MongoDB" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="660" y="80" width="160" height="1080" as="geometry" /></mxCell>
        <mxCell id="s_io" value=":Socket.IO server" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="860" y="80" width="160" height="1080" as="geometry" /></mxCell>
        <mxCell id="s_board" value=":board.html&lt;br&gt;(sockets in room:ROOM-01)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=50;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1060" y="80" width="160" height="1080" as="geometry" /></mxCell>
        <mxCell id="s_m0" value="POST /api/v1/students/{regNo}/bookings  { slotId }" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="170" as="sourcePoint" /><mxPoint x="340" y="170" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s_m1" value="requestLogger, express.json()" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="210" as="sourcePoint" /><mxPoint x="340" y="234" as="targetPoint" /><Array as="points"><mxPoint x="380" y="210" /><mxPoint x="380" y="234" /></Array></mxGeometry></mxCell>
        <mxCell id="s_m2" value="bookSlot(regNo, slotId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="260" as="sourcePoint" /><mxPoint x="540" y="260" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s_m3" value="Student.findOne({ regNo })" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="300" as="sourcePoint" /><mxPoint x="740" y="300" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s_m4" value="student  (null → 404 STUDENT_NOT_FOUND)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="340" as="sourcePoint" /><mxPoint x="540" y="340" as="targetPoint" /></mxGeometry></mxCell>
