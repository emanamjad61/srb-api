        <mxCell id="s_m16" value="booking { roomName, date, startHour, seatsLeft }" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="850" as="sourcePoint" /><mxPoint x="340" y="850" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s_m17" value="201 Created" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="890" as="sourcePoint" /><mxPoint x="140" y="890" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s_sep" value="" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="930" as="sourcePoint" /><mxPoint x="1260" y="930" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s_g2" value="[ slot already full: filter did not match, null returned ]" style="text;html=1;fontSize=11;fontStyle=2;align=left;" vertex="1" parent="1"><mxGeometry x="90" y="934" width="380" height="20" as="geometry" /></mxCell>
        <mxCell id="s_m18" value="null  (no document matched booked &amp;lt; seats)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="740" y="964" as="sourcePoint" /><mxPoint x="540" y="964" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s_m19" value="throw ApiError(409, &amp;quot;This slot has no free seats&amp;quot;, SLOT_FULL)" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540" y="1004" as="sourcePoint" /><mxPoint x="340" y="1004" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s_m20" value="errorHandler → standard error JSON" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;align=left;spacingLeft=6;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="1044" as="sourcePoint" /><mxPoint x="340" y="1068" as="targetPoint" /><Array as="points"><mxPoint x="380" y="1044" /><mxPoint x="380" y="1068" /></Array></mxGeometry></mxCell>
        <mxCell id="s_m21" value="409 { &amp;quot;error&amp;quot;: { &amp;quot;status&amp;quot;: 409, &amp;quot;message&amp;quot;: &amp;quot;This slot has no free seats&amp;quot;, &amp;quot;code&amp;quot;: &amp;quot;SLOT_FULL&amp;quot; } }" style="html=1;verticalAlign=bottom;endArrow=open;endFill=0;dashed=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="340" y="1094" as="sourcePoint" /><mxPoint x="140" y="1094" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="s_note" value="No seat is taken and no slot:updated event is sent, so the boards do not change." style="shape=note;whiteSpace=wrap;html=1;size=12;fontSize=11;fillColor=#fff2cc;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="480" y="1134" width="440" height="34" as="geometry" /></mxCell>
        <mxCell id="s_race" value="Why one findOneAndUpdate?&lt;br&gt;The check (booked &amp;lt; seats) and the $inc happen in a single atomic MongoDB operation. If two students race for the last seat, only one update matches; the other gets null → 409 SLOT_FULL." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;fontSize=11;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="1214" width="700" height="70" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
